{% import "_macros.xml.j2" as mx %}
<question type="shortanswer">
  {{ mx.name_and_stem(n) }}
  {{ mx.defaultgrade_penalty(n) }}
  <usecase>{{ n.usecase }}</usecase>
  {{ mx.answer_text_block(n.answers) }}
  {{- mx.combined_block(n) -}}
  {{- mx.hints_block(n) -}}
  {{- mx.tags_and_id(n) }}
</question>
