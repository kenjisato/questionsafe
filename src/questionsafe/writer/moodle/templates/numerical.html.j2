<div class="q">
  <h3>{{ n.name }}</h3>
  <div class="stem">{{ n.stem_html | safe }}</div>

  {% if n.units %}
    <div>
      <em>Units:</em> {{ n.units | map(attribute='unit') | join(", ") }}
      <span class="badge" title="showunits">show={{ n.showunits }}</span>
      <span class="badge" title="unitgradingtype">grade={{ n.unitgradingtype }}</span>
      {% if n.unitpenalty %}<span class="badge" title="unitpenalty">pen={{ n.unitpenalty }}</span>{% endif %}
      {% if n.unitsleft %}<span class="badge" title="unitsleft">left</span>{% endif %}
    </div>
  {% endif %}

  <details class="ans"><summary>Show answers</summary>
    <ul>
      {% for a in n.answers %}
        <li>
          {{ a.value }}{% if a.tolerance is not none %} ± {{ a.tolerance }}{% endif %}
          {% if a.fraction != 100 %}<span class="badge">{{ a.fraction }}%</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </details>

  {% if n.tags %}
    <div class="tags"><em>Tags:</em> {{ n.tags | join(", ") }}</div>
  {% endif %}
  {% if n.hints %}
    <details class="ans"><summary>Hints</summary>
      {% for h in n.hints %}<div>{{ h | safe }}</div>{% endfor %}
    </details>
  {% endif %}
</div>
